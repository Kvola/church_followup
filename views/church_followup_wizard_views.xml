<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_church_followup_assign_form" model="ir.ui.view">
        <field name="name">church.followup.assign.form</field>
        <field name="model">church.followup.assign</field>
        <field name="arch" type="xml">
            <form string="Ouvrir un suivi">
                <group>
                    <field name="member_ids" widget="many2many_tags"/>
                    <field name="church_id" invisible="1"/>
                    <field name="has_new" invisible="1"/>
                    <field name="has_old" invisible="1"/>
                    <field name="evangelist_id" options="{'no_create': True}" invisible="not has_new"
                           required="has_new"/>
                    <field name="prayer_cell_id" options="{'no_create': True}" invisible="not has_old"
                           placeholder="La cellule de chacun"/>
                    <div colspan="2" class="text-muted" invisible="not has_old or not has_new">
                        Les nouvelles personnes sont confiées à l'évangéliste, les anciens membres à
                        une cellule de prière.
                    </div>
                    <field name="duration_weeks"/>
                </group>
                <group string="Durées proposées" invisible="not proposal_summary">
                    <field name="proposal_summary" nolabel="1" colspan="2"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Ouvrir le suivi" type="object" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_church_followup_assign" model="ir.actions.act_window">
        <field name="name">Ouvrir un suivi</field>
        <field name="res_model">church.followup.assign</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_church_member"/>
        <field name="binding_view_types">list</field>
        <field name="context">{'default_member_ids': active_ids}</field>
    </record>

    <record id="view_church_followup_extend_form" model="ir.ui.view">
        <field name="name">church.followup.extend.form</field>
        <field name="model">church.followup.extend</field>
        <field name="arch" type="xml">
            <form string="Prolonger le suivi">
                <group>
                    <field name="followup_id"/>
                    <field name="current_weeks"/>
                    <field name="weeks"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Prolonger" type="object" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_church_followup_abandon_form" model="ir.ui.view">
        <field name="name">church.followup.abandon.form</field>
        <field name="model">church.followup.abandon</field>
        <field name="arch" type="xml">
            <form string="Interrompre le suivi">
                <p class="text-muted">
                    La personne passera en « Suivi interrompu ». Son suivi pourra être repris
                    plus tard ; ce motif restera dans son parcours.
                </p>
                <group>
                    <field name="followup_id"/>
                    <field name="reason" widget="radio"/>
                    <field name="note" required="reason == 'other'"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Interrompre" type="object" class="btn-danger"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
