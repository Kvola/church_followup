<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_church_mobile_user_form" model="ir.ui.view">
        <field name="name">church.mobile.user.form</field>
        <field name="model">church.mobile.user</field>
        <field name="arch" type="xml">
            <form string="Utilisateur mobile">
                <header>
                    <button name="action_share_invitation" string="Inviter" type="object"
                            class="btn-primary" icon="fa-whatsapp"
                            help="Un message à envoyer : installer l'application, puis se connecter avec ce numéro."/>
                    <button name="action_send_login_code" string="Envoyer un code de connexion" type="object"
                            class="btn-secondary" icon="fa-key"
                            help="Envoie un code comme le ferait l'application, dit par où il est parti, et l'affiche pour pouvoir le dicter."/>
                    <button name="action_close_session" string="Fermer les sessions" type="object"
                            class="btn-secondary" icon="fa-sign-out" invisible="not open_session_count"
                            confirm="Les téléphones connectés à ce compte devront redemander un code. Continuer ?"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nom complet"/></h1>
                    </div>
                    <group>
                        <group string="Connexion par code">
                            <field name="phone" widget="phone" required="role != 'super_admin' or not email"/>
                            <field name="phone_e164"/>
                            <field name="email" widget="email" placeholder="Facultatif"/>
                            <field name="last_login"/>
                            <field name="role"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="user_id" invisible="not user_id"/>
                        </group>
                        <group string="Affectation">
                            <field name="church_id" required="role != 'super_admin'"
                                   domain="[('followup_enabled', '=', True)]" options="{'no_create': True}"/>
                            <field name="evangelist_id" invisible="role != 'evangelist'"/>
                            <field name="prayer_cell_id" invisible="role != 'cell_leader'"/>
                            <field name="age_group_id" invisible="role != 'group_leader'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sessions" name="page_sessions">
                            <p class="text-muted">
                                Une ligne par téléphone connecté. Une session fermée reste ici pour
                                la trace : quel appareil, coupé quand.
                            </p>
                            <field name="open_session_count" invisible="1"/>
                            <field name="session_ids" readonly="1">
                                <list decoration-muted="revoked">
                                    <field name="device_label"/>
                                    <field name="create_date" string="Ouverte le"/>
                                    <field name="last_seen"/>
                                    <field name="expires_at"/>
                                    <field name="revoked"/>
                                    <button name="action_revoke" type="object" string="Fermer"
                                            icon="fa-sign-out" invisible="revoked"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_church_mobile_user_invite_form" model="ir.ui.view">
        <field name="name">church.mobile.user.invite.form</field>
        <field name="model">church.mobile.user.invite</field>
        <field name="arch" type="xml">
            <form string="Inviter à l'application">
                <div class="alert alert-info" role="alert">
                    Aucun secret dans ce message : le code de connexion arrive sur le numéro
                    du compte, au moment de se connecter.
                </div>
                <group>
                    <field name="mobile_user_id" readonly="1"/>
                    <field name="phone" widget="phone"/>
                    <!-- Sans widget de copie : il écrase les retours à la ligne. -->
                    <field name="message"/>
                    <field name="whatsapp_url" widget="url" string="WhatsApp" text="Envoyer par WhatsApp"/>
                </group>
                <footer>
                    <button string="Fermer" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_church_mobile_user_code_form" model="ir.ui.view">
        <field name="name">church.mobile.user.code.form</field>
        <field name="model">church.mobile.user.code</field>
        <field name="arch" type="xml">
            <form string="Code de connexion">
                <div class="alert alert-info" role="alert">
                    Le code vaut 10 minutes, une seule fois. Si rien n'arrive sur le téléphone,
                    dictez-le : la personne saisit l'identifiant ci-dessous, puis ce code.
                </div>
                <group>
                    <field name="mobile_user_id" readonly="1"/>
                    <field name="identifier"/>
                    <field name="code" class="fs-3 fw-bold"/>
                    <field name="report"/>
                </group>
                <footer>
                    <button string="Fermer" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_church_mobile_user_list" model="ir.ui.view">
        <field name="name">church.mobile.user.list</field>
        <field name="model">church.mobile.user</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="phone" widget="phone"/>
                <field name="email" optional="hide"/>
                <field name="role" widget="badge"
                       decoration-info="role == 'evangelist'"
                       decoration-success="role == 'super_admin'"
                       decoration-warning="role in ('cell_leader', 'group_leader')"
                       decoration-primary="role == 'manager'"/>
                <field name="church_id" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_church_mobile_user_search" model="ir.ui.view">
        <field name="name">church.mobile.user.search</field>
        <field name="model">church.mobile.user</field>
        <field name="arch" type="xml">
            <search string="Rechercher un utilisateur mobile">
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="church_id"/>
                <separator/>
                <filter name="filter_evangelist" string="Évangélistes" domain="[('role', '=', 'evangelist')]"/>
                <filter name="filter_cell_leader" string="Resp. cellules" domain="[('role', '=', 'cell_leader')]"/>
                <filter name="filter_group_leader" string="Resp. groupes" domain="[('role', '=', 'group_leader')]"/>
                <filter name="filter_manager" string="Responsables" domain="[('role', '=', 'manager')]"/>
                <filter name="filter_admin" string="Super admin" domain="[('role', '=', 'super_admin')]"/>
                <separator/>
                <filter name="filter_active" string="Actifs" domain="[('active', '=', True)]"/>
                <filter name="filter_inactive" string="Inactifs" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_role" string="Rôle" context="{'group_by': 'role'}"/>
                    <filter name="group_church" string="Église" context="{'group_by': 'church_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_church_mobile_user" model="ir.actions.act_window">
        <field name="name">Utilisateurs mobiles</field>
        <field name="res_model">church.mobile.user</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_church_mobile_user_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun utilisateur mobile
            </p>
            <p>
                Les comptes mobiles sont créés automatiquement lors de l'ajout d'évangélistes ou via les cellules/groupes.
            </p>
        </field>
    </record>
</odoo>
