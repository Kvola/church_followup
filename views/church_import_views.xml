<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_church_import_wizard_form" model="ir.ui.view">
        <field name="name">church.import.wizard.form</field>
        <field name="model">church.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importer un fichier">
                <field name="state" invisible="1"/>
                <div class="alert alert-info" role="alert" invisible="state != 'draft'">
                    Téléchargez le modèle de l'église, remplissez-le, puis importez-le. Le fichier est
                    vérifié en entier : à la moindre erreur, <strong>rien n'est importé</strong>.
                    Une fiche qui existe déjà est complétée, jamais écrasée.
                </div>
                <div class="alert alert-success" role="alert" invisible="state != 'done'">
                    <field name="result_message" nolabel="1"/>
                </div>
                <div class="alert alert-danger" role="alert" invisible="state != 'refused'">
                    <field name="result_message" nolabel="1"/>
                </div>
                <group invisible="state != 'draft'">
                    <field name="church_id" options="{'no_create': True}"/>
                    <field name="kind"/>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <group invisible="state == 'draft'">
                    <field name="result_errors" invisible="not result_errors"/>
                    <field name="result_warnings" invisible="not result_warnings"/>
                </group>
                <footer>
                    <button name="action_import" string="Importer" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_download_template" string="Télécharger le modèle" type="object"
                            class="btn-secondary" icon="fa-download" invisible="state != 'draft'"/>
                    <button name="action_retry" string="Importer un autre fichier" type="object"
                            class="btn-primary" invisible="state == 'draft'"/>
                    <button string="Fermer" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_church_import_wizard" model="ir.actions.act_window">
        <field name="name">Importer un fichier</field>
        <field name="res_model">church.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_church_import_log_list" model="ir.ui.view">
        <field name="name">church.import.log.list</field>
        <field name="model">church.import.log</field>
        <field name="arch" type="xml">
            <list create="false" decoration-danger="state == 'refused'">
                <field name="create_date" string="Le"/>
                <field name="church_id"/>
                <field name="kind"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"
                       decoration-danger="state == 'refused'"/>
                <field name="message"/>
                <field name="mobile_user_id" optional="show"/>
                <field name="user_id" optional="hide"/>
                <field name="filename" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_church_import_log_form" model="ir.ui.view">
        <field name="name">church.import.log.form</field>
        <field name="model">church.import.log</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <div class="oe_title"><h1><field name="message"/></h1></div>
                    <group>
                        <group>
                            <field name="church_id"/>
                            <field name="kind"/>
                            <field name="state"/>
                            <field name="create_date" string="Le"/>
                            <field name="mobile_user_id"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="created_count"/>
                            <field name="updated_count"/>
                            <field name="unchanged_count"/>
                            <field name="error_count"/>
                            <field name="file" filename="filename"/>
                            <field name="filename" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="errors" invisible="not errors"/>
                        <field name="warnings" invisible="not warnings"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_church_import_log_search" model="ir.ui.view">
        <field name="name">church.import.log.search</field>
        <field name="model">church.import.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="church_id"/>
                <field name="kind"/>
                <filter name="refused" string="Refusés" domain="[('state', '=', 'refused')]"/>
                <group>
                    <filter name="by_church" string="Église" context="{'group_by': 'church_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_church_import_log" model="ir.actions.act_window">
        <field name="name">Historique des imports</field>
        <field name="res_model">church.import.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
