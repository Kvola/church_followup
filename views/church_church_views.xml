<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- L'église est celle de l'annuaire du réseau (church_core). Ces vues sont
         celles du suivi : priorité haute pour ne pas remplacer celles de
         l'annuaire, et appelées explicitement par l'action ci-dessous. -->
    <record id="view_church_church_form" model="ir.ui.view">
        <field name="name">equipment.church.followup.form</field>
        <field name="model">equipment.church</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <form string="Église">
                <header>
                    <field name="followup_enabled" widget="boolean_toggle"/>
                    <span class="text-muted ms-2">Suivi d'évangélisation actif</span>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-users" type="object" name="action_view_members">
                            <field name="member_count" widget="statinfo" string="Membres"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-book" type="object" name="action_view_evangelists">
                            <field name="evangelist_count" widget="statinfo" string="Évangélistes"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-home" type="object" name="action_view_cells">
                            <field name="cell_count" widget="statinfo" string="Cellules"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-th-large" type="object" name="action_view_age_groups">
                            <field name="age_group_count" widget="statinfo" string="Groupes"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-line-chart" type="object" name="action_view_active_followups">
                            <field name="followup_active_count" widget="statinfo" string="Suivis actifs"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nom de l'église"/></h1>
                    </div>
                    <group>
                        <group string="Suivi des nouvelles personnes">
                            <field name="default_followup_weeks"/>
                            <field name="integration_min_attendance"/>
                        </group>
                        <group string="Dans l'annuaire du réseau">
                            <field name="region_id" options="{'no_create': True}"/>
                            <field name="code"/>
                            <field name="city"/>
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Pasteurs" name="page_pastors">
                            <p class="text-muted">
                                Les pasteurs viennent de l'annuaire du réseau : on les ajoute, les mute
                                ou les retire depuis la gestion des églises, pas d'ici. Les titulaires
                                sont ceux que l’application affiche comme pasteurs de l’église.
                            </p>
                            <field name="pastor_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="function" widget="badge"
                                           decoration-success="function == 'pastor'"
                                           decoration-info="function == 'missionary'"/>
                                    <field name="phone" widget="phone"/>
                                    <field name="email" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Quartiers" name="page_districts">
                            <field name="district_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="city"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_church_church_list" model="ir.ui.view">
        <field name="name">equipment.church.followup.list</field>
        <field name="model">equipment.church</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="region_id" optional="show"/>
                <field name="city" optional="show"/>
                <field name="pastor_name"/>
                <field name="member_count"/>
                <field name="evangelist_count"/>
                <field name="cell_count"/>
                <field name="age_group_count" optional="hide"/>
                <field name="followup_active_count" string="Suivis actifs"/>
            </list>
        </field>
    </record>

    <record id="view_church_church_search" model="ir.ui.view">
        <field name="name">equipment.church.followup.search</field>
        <field name="model">equipment.church</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <search string="Rechercher une église">
                <field name="name"/>
                <field name="code"/>
                <field name="city"/>
                <field name="region_id"/>
                <separator/>
                <filter name="filter_followup" string="Suivi actif" domain="[('followup_enabled', '=', True)]"/>
                <filter name="filter_archived" string="Archivées" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_region" string="Région" context="{'group_by': 'region_id'}"/>
                    <filter name="group_city" string="Ville" context="{'group_by': 'city'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_church_church" model="ir.actions.act_window">
        <field name="name">Églises</field>
        <field name="res_model">equipment.church</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_church_church_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_church_church_form')})]"/>
        <field name="search_view_id" ref="view_church_church_search"/>
        <field name="context">{'search_default_filter_followup': 1, 'default_followup_enabled': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune église ne suit encore de nouvelles personnes
            </p>
            <p>
                Retirez le filtre « Suivi actif » pour voir tout l'annuaire du réseau, ouvrez
                l'église et activez « Suivi d'évangélisation ».
            </p>
        </field>
    </record>
</odoo>
